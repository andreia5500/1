<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/btn_eq</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="CalcButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/btn_num</item>
        <item name="android:onClick">onButton</item>
    </style>

    <style name="CalcButton.Fn">
        <item name="android:background">@drawable/btn_fn</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalcButton.Op">
        <item name="android:background">@drawable/btn_op</item>
        <item name="android:textColor">@color/btn_op_text</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="CalcButton.Eq">
        <item name="android:background">@drawable/btn_eq</item>
        <item name="android:textSize">32sp</item>
    </style>
</resources>
